# Required: canonical CMS origin, no trailing slash. HTTPS is mandatory in production.
CMS_URL=http://localhost:3000
# Required: generate a private, stable value with `openssl rand -hex 32`.
# Must be set before startup. Changing it invalidates authentication tokens.
PAYLOAD_SECRET=
# Required: SQLite file URL. Relative paths are resolved from the project root.
# Production: file:/var/lib/payload/cms.db on a persistent writable volume.
DATABASE_URL=file:./cms.db

# Optional: exact browser frontend origins, comma-separated, no paths/trailing slashes.
# CORS is not authorization. These origins are NOT trusted for CMS cookie mutations.
# Site domain records do not automatically change this allowlist.
FRONTEND_ORIGINS=http://localhost:3001,http://localhost:3002

# Optional: default false (private local ./media directory).
# Set true for private S3-compatible production uploads. All four credentials below
# are required when enabled. Provision the bucket independently; block public access.
S3_ENABLED=false
# Optional: private local uploads directory (default ./media); use a durable
# absolute directory in production when S3 is off. Never point this at public/.
MEDIA_DIR=./media
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: leave empty for AWS S3; set for other S3-compatible providers.
S3_ENDPOINT=
# Optional: true for providers such as MinIO that require path-style URLs.
S3_FORCE_PATH_STYLE=false

# Optional, seed command only: needed only if no administrator exists.
# Prefer creating the first administrator interactively at /admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
